/.swebench_cache/
/.siren-docker-cache/
/jobs/
/multirun/
/resume_jobs/
/runs/
/traces/
/images/

# Generated image/container archives and scheduler output
*.tar
*.tar.gz
*.tgz
*.sif
*.slurm
*.log
*.out
/*.sh
/scripts/*.sh

# Local analysis data and working directories
/open_coding/
/open_coding_arian/
