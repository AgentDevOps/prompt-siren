*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Packaging output
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
.venv-*/
venv/

# Secrets and local environment overrides
.env
.env.*
!.env.example
*.pem

# Editor and OS files
/.claude/
.vscode/
.idea/
.DS_Store
*~
*.swp

# Exported/local configuration (defaults live under src/prompt_siren/config)
/config/

